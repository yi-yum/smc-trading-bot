# ── 複製此檔案為 .env，填入你的金鑰 ──
# 部署到 Railway 時直接在 Variables 頁面設定，不需要 .env 檔案

# LINE Messaging API (https://developers.line.me)
# Channel Access Token: Channel 頁面 → Messaging API → Channel access token → Issue
LINE_TOKEN=你的_Channel_Access_Token
# 你自己的 User ID: Channel 頁面 → Basic settings → Your user ID
LINE_USER_ID=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 幣安 Testnet API (https://testnet.binancefuture.com/ 申請)
BINANCE_API_KEY=你的_API_KEY
BINANCE_SECRET=你的_SECRET

# 是否使用測試網 (true = 模擬, false = 真實)
BINANCE_TESTNET=true

# 策略設定 (A / B / C / ALL)
ACTIVE_STRATEGY=A

# 主時框架 (15m / 1h / 4h / 1d)
PRIMARY_TF=4h

# 每筆模擬倉位 USDT
POSITION_USDT=100

# 進場門檻
REQUIRE_KILL_ZONE=true
REQUIRE_STRONG_DISP=true
MIN_RR=1.5

# 掃描間隔秒數 (預設 3600 = 每小時)
SCAN_INTERVAL_SECONDS=3600

# ── AdaptiveTrend 策略 (Strategy D) ──
# 是否啟用 AdaptiveTrend 動量策略 (true = 啟用)
AT_ENABLE=false

# 主時框架改用 6h 以配合 AdaptiveTrend 最佳化設定
# PRIMARY_TF=6h

# 動量回看週期 (H6 K棒數，建議 12~48，預設 20 ≈ 5 天)
AT_LOOKBACK_L=20

# 動量進場閾值 θ (0.01~0.05，超過此值才觸發信號)
AT_THETA_ENTRY=0.02

# ATR 乘數 α (追蹤止損距離，建議 2.0~4.0)
AT_ATR_MULT=2.5

# 多頭資金比例 (70/30 架構，多頭佔 0.7)
AT_LONG_RATIO=0.7

# 月度夏普比率篩選門檻 (多頭 >= 1.3，空頭 >= 1.7)
AT_MIN_SHARPE_LONG=1.3
AT_MIN_SHARPE_SHORT=1.7
